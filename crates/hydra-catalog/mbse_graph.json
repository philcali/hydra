{
  "version": "1",
  "nodes": [
    {
      "id": "CONOPS-001",
      "type": "conops",
      "text": "Operator authenticates via OIDC or certificate, reviews and manages device catalog, and issues commands through the API gateway. All actions are audited.",
      "metadata": {
        "status": "accepted",
        "scenario": "operator_onboarding"
      }
    },
    {
      "id": "CONOPS-002",
      "type": "conops",
      "text": "Devices are discovered on the edge network, registered in the catalog, matched to a driver, and begin telemetry collection.",
      "metadata": {
        "status": "accepted",
        "scenario": "device_onboarding"
      }
    },
    {
      "id": "CONOPS-003",
      "type": "conops",
      "text": "Operators and automated systems trigger flows (e.g., fleet config rotation) that are dispatched to heterogeneous device drivers, each adapting to device-specific protocols.",
      "metadata": {
        "status": "accepted",
        "scenario": "flow_execution"
      }
    },
    {
      "id": "CONOPS-004",
      "type": "conops",
      "text": "When a driver loses communication with a device, the degradation manager activates a graceful fallback, emits a metric stream event, and records the degradation in the audit log.",
      "metadata": {
        "status": "accepted",
        "scenario": "failure_degradation"
      }
    },
    {
      "id": "CONOPS-005",
      "type": "conops",
      "text": "Hydra scales to support thousands of devices across a distributed cluster, maintaining responsive discovery, catalog consistency, and telemetry throughput.",
      "metadata": {
        "status": "accepted",
        "scenario": "multi_node_scale"
      }
    },
    {
      "id": "REQ-001",
      "type": "requirement",
      "text": "Hydra must support custom identity pool providers via OIDC protocol.",
      "metadata": {
        "status": "accepted",
        "owner": "auth"
      }
    },
    {
      "id": "REQ-002",
      "type": "requirement",
      "text": "Hydra must support granular ACL for authorization.",
      "metadata": {
        "status": "accepted",
        "owner": "auth"
      }
    },
    {
      "id": "REQ-003",
      "type": "requirement",
      "text": "Hydra must allow operators to scope specific operations to roles and principals.",
      "metadata": {
        "status": "accepted",
        "owner": "auth"
      }
    },
    {
      "id": "REQ-017",
      "type": "requirement",
      "text": "Hydra must support certificate-based authentication (mTLS / device certs) as an alternative identity mechanism.",
      "metadata": {
        "status": "accepted",
        "owner": "auth"
      }
    },
    {
      "id": "REQ-004",
      "type": "requirement",
      "text": "Hydra must expose an API with operations for device management.",
      "metadata": {
        "status": "accepted",
        "owner": "platform"
      }
    },
    {
      "id": "REQ-005",
      "type": "requirement",
      "text": "Hydra must have a queryable device catalog.",
      "metadata": {
        "status": "accepted",
        "owner": "platform"
      }
    },
    {
      "id": "REQ-006",
      "type": "requirement",
      "text": "Hydra must allow grouping devices into categories called fleets.",
      "metadata": {
        "status": "accepted",
        "owner": "platform"
      }
    },
    {
      "id": "REQ-007",
      "type": "requirement",
      "text": "Hydra must allow operators to manage the device catalog (CRUD operations).",
      "metadata": {
        "status": "accepted",
        "owner": "platform"
      }
    },
    {
      "id": "REQ-008",
      "type": "requirement",
      "text": "Hydra must support discovery of devices on the edge network.",
      "metadata": {
        "status": "accepted",
        "owner": "discovery"
      }
    },
    {
      "id": "REQ-009",
      "type": "requirement",
      "text": "Hydra must support retrieving device configuration.",
      "metadata": {
        "status": "accepted",
        "owner": "drivers"
      }
    },
    {
      "id": "REQ-010",
      "type": "requirement",
      "text": "Hydra must support setting device configuration.",
      "metadata": {
        "status": "accepted",
        "owner": "drivers"
      }
    },
    {
      "id": "REQ-011",
      "type": "requirement",
      "text": "Hydra must support communicating to heterogeneous device types and vendors.",
      "metadata": {
        "status": "accepted",
        "owner": "drivers"
      }
    },
    {
      "id": "REQ-012",
      "type": "requirement",
      "text": "Hydra must support operation degradation when programmatic control for a device is unavailable.",
      "metadata": {
        "status": "accepted",
        "owner": "drivers"
      }
    },
    {
      "id": "REQ-013",
      "type": "requirement",
      "text": "Hydra must poll devices for telemetry or receive telemetry via a push model.",
      "metadata": {
        "status": "accepted",
        "owner": "telemetry"
      }
    },
    {
      "id": "REQ-014",
      "type": "requirement",
      "text": "Hydra must scale to support thousands of devices.",
      "metadata": {
        "status": "accepted",
        "owner": "platform"
      }
    },
    {
      "id": "REQ-015",
      "type": "requirement",
      "text": "Hydra must provide a metric stream for reactive integration (e.g., device unhealthy events).",
      "metadata": {
        "status": "accepted",
        "owner": "telemetry"
      }
    },
    {
      "id": "REQ-016",
      "type": "requirement",
      "text": "Hydra must maintain an immutable audit log for all actions made to devices.",
      "metadata": {
        "status": "accepted",
        "owner": "audit"
      }
    },
    {
      "id": "ARCH-AUTH",
      "type": "component",
      "text": "Auth service: identity provider integration, ACL engine, operation scoping."
    },
    {
      "id": "ARCH-CATALOG",
      "type": "component",
      "text": "Device catalog: stores device metadata, state, and relationships."
    },
    {
      "id": "ARCH-FLEET",
      "type": "component",
      "text": "Fleet manager: groups devices into categories, manages fleet membership."
    },
    {
      "id": "ARCH-DISCOVERY",
      "type": "component",
      "text": "Discovery engine: detects and registers devices on the edge network."
    },
    {
      "id": "ARCH-DRIVERS",
      "type": "component",
      "text": "Driver framework: registry, communication bus, and degradation manager for heterogeneous devices."
    },
    {
      "id": "ARCH-TELEMETRY",
      "type": "component",
      "text": "Telemetry service: collects device telemetry via poll/push and emits metric stream events."
    },
    {
      "id": "ARCH-AUDIT",
      "type": "component",
      "text": "Audit service: ingests and persists immutable audit records for all device actions."
    },
    {
      "id": "P-AUTH-TIMEOUT",
      "type": "parameter",
      "text": "Maximum authentication latency.",
      "metadata": {
        "name": "auth_timeout",
        "unit": "ms",
        "bound": "max",
        "value": 5000
      }
    },
    {
      "id": "P-ACL-EVAL-LATENCY",
      "type": "parameter",
      "text": "Maximum ACL evaluation latency per request.",
      "metadata": {
        "name": "acl_eval_latency",
        "unit": "ms",
        "bound": "max",
        "value": 100
      }
    },
    {
      "id": "P-CATALOG-SYNC-LAG",
      "type": "parameter",
      "text": "Maximum catalog sync lag across cluster nodes.",
      "metadata": {
        "name": "catalog_sync_lag",
        "unit": "s",
        "bound": "max",
        "value": 5
      }
    },
    {
      "id": "P-DISCOVERY-INTERVAL",
      "type": "parameter",
      "text": "Maximum interval between device discovery polls.",
      "metadata": {
        "name": "discovery_interval",
        "unit": "s",
        "bound": "max",
        "value": 60
      }
    },
    {
      "id": "P-DRIVER-TIMEOUT",
      "type": "parameter",
      "text": "Maximum driver communication timeout before degradation activates.",
      "metadata": {
        "name": "driver_timeout",
        "unit": "ms",
        "bound": "max",
        "value": 3000
      }
    },
    {
      "id": "P-TELEM-INTERVAL",
      "type": "parameter",
      "text": "Maximum telemetry collection interval.",
      "metadata": {
        "name": "telemetry_interval",
        "unit": "s",
        "bound": "max",
        "value": 30
      }
    },
    {
      "id": "P-METRIC-STREAM-LAG",
      "type": "parameter",
      "text": "Maximum latency for metric stream event delivery.",
      "metadata": {
        "name": "metric_stream_lag",
        "unit": "ms",
        "bound": "max",
        "value": 1000
      }
    },
    {
      "id": "P-AUDIT-FLUSH-LATENCY",
      "type": "parameter",
      "text": "Maximum latency for audit log flush to durable store.",
      "metadata": {
        "name": "audit_flush_latency",
        "unit": "ms",
        "bound": "max",
        "value": 100
      }
    },
    {
      "id": "P-SCALE-DEVICE-COUNT",
      "type": "parameter",
      "text": "Maximum number of devices per Hydra cluster node.",
      "metadata": {
        "name": "devices_per_node",
        "unit": "count",
        "bound": "max",
        "value": 1000
      }
    },
    {
      "id": "ARCH-CTRL-GW",
      "type": "component",
      "text": "Control plane API gateway: ingress for operator/system operations, enforces auth and ACL."
    },
    {
      "id": "ARCH-DATA-GW",
      "type": "component",
      "text": "Data plane gateway: routes device communication requests to drivers, handles telemetry ingestion."
    },
    {
      "id": "ARCH-CATALOG-SVC",
      "type": "component",
      "text": "Device catalog CRUD service: queries, mutations, fleet operations backed by persistent store."
    },
    {
      "id": "ARCH-CATALOG-STORE",
      "type": "component",
      "text": "Persistent backend for device catalog (relational storage for device metadata, state, fleet membership)."
    },
    {
      "id": "ARCH-SYS-MGMT",
      "type": "component",
      "text": "System management: cluster configuration, health monitoring, scaling coordination."
    },
    {
      "id": "ARCH-STORAGE",
      "type": "component",
      "text": "Storage interface: abstract device catalog persistence layer."
    },
    {
      "id": "ARCH-STORAGE-SQLITE",
      "type": "component",
      "text": "SQLite implementation: single-node, edge deployment."
    },
    {
      "id": "ARCH-STORAGE-POSTGRES",
      "type": "component",
      "text": "PostgreSQL implementation: multi-node, production deployment."
    },
    {
      "id": "P-CATALOG-WRITE-LATENCY",
      "type": "parameter",
      "text": "Maximum write latency for catalog operations.",
      "metadata": {
        "name": "catalog_write_latency",
        "unit": "ms",
        "bound": "max",
        "value": 100
      }
    },
    {
      "id": "REQ-018",
      "type": "requirement",
      "text": "Hydra must declare, per device, the fidelity of operations its driver supports (telemetry, config read, config write, command), and the API must only offer operations within that fidelity.",
      "metadata": {
        "status": "accepted",
        "owner": "platform"
      }
    },
    {
      "id": "REQ-019",
      "type": "requirement",
      "text": "In the absence of an external identity provider, Hydra must manage local identities statefully: create, read, update, and delete identities (principals).",
      "metadata": {
        "status": "accepted",
        "owner": "auth"
      }
    },
    {
      "id": "REQ-020",
      "type": "requirement",
      "text": "Hydra must manage credentials for local identities — set, rotate, and verify — statefully.",
      "metadata": {
        "status": "accepted",
        "owner": "auth"
      }
    },
    {
      "id": "REQ-021",
      "type": "requirement",
      "text": "Hydra must assign and modify roles on local identities, reflected in ACL decisions.",
      "metadata": {
        "status": "accepted",
        "owner": "auth"
      }
    },
    {
      "id": "REQ-022",
      "type": "requirement",
      "text": "Hydra must persist auth state (identities, credentials, and roles) so it survives a restart.",
      "metadata": {
        "status": "accepted",
        "owner": "auth"
      }
    },
    {
      "id": "ARCH-IAM",
      "type": "component",
      "text": "Local identity & access management: stateful store of identities, credentials, and roles; active when no external IdP is configured."
    },
    {
      "id": "REQ-023",
      "type": "requirement",
      "text": "Hydra must issue device certificates from a trusted certificate authority (local CA signing).",
      "metadata": {
        "status": "accepted",
        "owner": "auth"
      }
    },
    {
      "id": "REQ-024",
      "type": "requirement",
      "text": "Hydra must distribute issued device certificates to edge devices.",
      "metadata": {
        "status": "accepted",
        "owner": "auth"
      }
    },
    {
      "id": "REQ-025",
      "type": "requirement",
      "text": "Hydra must revoke device certificates and reject revoked ones (revocation list).",
      "metadata": {
        "status": "accepted",
        "owner": "auth"
      }
    },
    {
      "id": "ARCH-PKI",
      "type": "component",
      "text": "Local PKI: device certificate authority, distribution, and revocation; stateful."
    },
    {
      "id": "REQ-026",
      "type": "requirement",
      "text": "Hydra must poll telemetry per registered device, pulling each device's readings through its driver into the metric stream.",
      "metadata": {
        "status": "accepted",
        "owner": "telemetry"
      }
    },
    {
      "id": "CONOPS-006",
      "type": "conops",
      "text": "The data plane polls devices and pushes their metrics to registered delivery targets (push endpoints), running as a separate unit that scales independently of the stateless control plane.",
      "metadata": {
        "status": "accepted",
        "scenario": "data_plane_fanout"
      }
    },
    {
      "id": "REQ-027",
      "type": "requirement",
      "text": "The data plane must deliver metric events to registered delivery targets (push targets / endpoints).",
      "metadata": {
        "status": "accepted",
        "owner": "telemetry"
      }
    },
    {
      "id": "REQ-028",
      "type": "requirement",
      "text": "Delivery targets must be registered and scoped to the devices/events they are entitled to receive.",
      "metadata": {
        "status": "accepted",
        "owner": "telemetry"
      }
    },
    {
      "id": "REQ-029",
      "type": "requirement",
      "text": "The data plane's metric delivery must be a separate, independently scalable unit from the stateless control plane.",
      "metadata": {
        "status": "accepted",
        "owner": "telemetry"
      }
    },
    {
      "id": "ARCH-FANOUT",
      "type": "component",
      "text": "Metric fan-out: pushes events to registered delivery targets (endpoints); a separate, scalable data-plane unit."
    },
    {
      "id": "REQ-030",
      "type": "requirement",
      "text": "The data plane must deliver metric stream events to the registered delivery targets entitled to them (the stream→fan-out bridge).",
      "metadata": {
        "status": "accepted",
        "owner": "telemetry"
      }
    },
    {
      "id": "REQ-031",
      "type": "requirement",
      "text": "A delivery target's transport must be pluggable (an adapter boundary), so the same target can push events in-process or to a remote HTTP endpoint.",
      "metadata": {
        "status": "accepted",
        "owner": "telemetry"
      }
    },
    {
      "id": "CONOPS-007",
      "type": "conops",
      "text": "An operator creates a discovery configuration; discovery scans and emits discovery events on the metric stream; a consumer reacts to drive provisioning — registering the device, binding its driver, and assigning it to a fleet.",
      "metadata": {
        "status": "accepted",
        "scenario": "discovery_provisioning"
      }
    },
    {
      "id": "REQ-032",
      "type": "requirement",
      "text": "The control plane must manage discovery configurations as first-class resources (create/read/update), each defining the scan cadence and the vendor/type filter.",
      "metadata": {
        "status": "accepted",
        "owner": "platform"
      }
    },
    {
      "id": "REQ-033",
      "type": "requirement",
      "text": "Discovery must emit a discovery event on the metric stream when it finds a new device, so downstream consumers can react.",
      "metadata": {
        "status": "accepted",
        "owner": "telemetry"
      }
    }
  ],
